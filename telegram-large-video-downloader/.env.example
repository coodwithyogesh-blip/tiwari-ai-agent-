# Telegram API credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Render receiver endpoint and secret (configure after receiver is deployed)
RENDER_UPLOAD_URL=https://YOUR-RENDER-SERVICE.example/upload/large-video
RENDER_UPLOAD_TOKEN=replace-with-a-long-random-secret

# Temporary download folder on Android shared storage or app storage
DOWNLOAD_DIR=./downloads
